<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Version>1.2.2</Version>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>../../wmpl_recap_icon_bar.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WmplWrap/WmplWrap.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="../../wmpl_recap_icon_header.ico" Link="Assets/wmpl_recap_icon_header.ico" />
    <Content Include="../../wmpl_recap_icon_bar.ico" Link="Assets/wmpl_recap_icon_bar.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Discord/wmp_empty.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Discord/wmp_icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
