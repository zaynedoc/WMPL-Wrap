<Window x:Class="WmplWrap.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:WmplWrap.Desktop"
        Title="WMPL Wrap" Icon="/Assets/wmpl_recap_icon_header.ico" Width="1160" Height="760" MinWidth="920" MinHeight="600"
        Background="{DynamicResource Brush.AppBackground}" FontFamily="{StaticResource Font.Body}" MouseDoubleClick="OpenInWmpDoubleClick">
  <Window.Resources>
    <DataTemplate x:Key="SongRow">
      <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding CountLabel}" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Accent}" FontSize="11" VerticalAlignment="Center" />
        <Border Grid.Column="1" Width="40" Height="40" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="2"><Image Source="{Binding Artwork}" Stretch="UniformToFill" /></Border>
        <StackPanel Grid.Column="2" Margin="8,1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ArtistAlbum}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="AggregateRow">
      <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource Brush.Accent}" FontFamily="{StaticResource Font.Mono}" FontSize="11" VerticalAlignment="Center" />
        <Border Grid.Column="1" Width="40" Height="40" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="2"><Image Source="{Binding Artwork}" Stretch="UniformToFill" /></Border>
        <StackPanel Grid.Column="2" Margin="8,1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SnapshotChangeTrack">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="2"><Image Source="{Binding Artwork}" Stretch="UniformToFill" /></Border>
        <StackPanel Grid.Column="1" Margin="8,1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="25" /></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="0,0,0,1">
      <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource NavigationButton}" Content="&#x2190;" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="Back" />
        <Button Grid.Column="1" Style="{StaticResource NavigationButton}" Content="&#x2192;" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="Forward" />
        <TextBlock Grid.Column="3" Text="{Binding Breadcrumbs}" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource Brush.Rail}">
        <StackPanel Margin="10,18,10,0" HorizontalAlignment="Stretch">
          <TextBlock Text="LIBRARY" Foreground="{DynamicResource Brush.RailText}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,7" />
          <Button Style="{StaticResource RailButton}" Content="Overview" Command="{Binding NavigateCommand}" CommandParameter="Overview" />
          <Button Style="{StaticResource RailButton}" Content="Graphs" Command="{Binding NavigateCommand}" CommandParameter="Graphs" />
          <TextBlock Text="DATA" Foreground="{DynamicResource Brush.RailText}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold" Margin="10,18,0,7" />
          <Button Style="{StaticResource RailButton}" Content="Top songs" Command="{Binding NavigateCommand}" CommandParameter="Data:Tracks" />
          <Button Style="{StaticResource RailButton}" Content="Top albums" Command="{Binding NavigateCommand}" CommandParameter="Data:Albums" />
          <Button Style="{StaticResource RailButton}" Content="Top artists" Command="{Binding NavigateCommand}" CommandParameter="Data:Artists" />
          <Button Style="{StaticResource RailButton}" Content="Snapshot history" Command="{Binding NavigateCommand}" CommandParameter="LatestSnapshot" />
          <TextBlock Text="MANAGE" Foreground="{DynamicResource Brush.RailText}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold" Margin="10,18,0,7" />
          <Button Style="{StaticResource RailButton}" Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="28,25,28,20" Visibility="{Binding OverviewVisibility}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Listening history" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="{Binding SnapshotSummary}" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox Style="{StaticResource PeriodComboBox}" Width="148" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" Height="32" Margin="0,0,8,0" /><Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" /><Button Content="{Binding CaptureButtonText}" Command="{Binding CaptureCommand}" IsEnabled="{Binding CanCapture}" Style="{StaticResource PrimaryButton}" /></StackPanel>
          </Grid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="LISTENS" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" /><TextBlock Text="{Binding TotalListens}" FontFamily="{StaticResource Font.Display}" FontSize="23" Foreground="{DynamicResource Brush.Ink}" Margin="0,3,0,0" /><TextBlock Text="{Binding MetricPeriodCaption}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" Margin="0,2,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="LISTENING TIME" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" /><TextBlock Text="{Binding TotalListeningTime}" FontFamily="{StaticResource Font.Display}" FontSize="23" Foreground="{DynamicResource Brush.Ink}" Margin="0,3,0,0" /><TextBlock Text="{Binding MetricPeriodCaption}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" Margin="0,2,0,0" /></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="TOP ARTIST" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" /><TextBlock Text="{Binding MetricTopArtist}" FontFamily="{StaticResource Font.Display}" FontSize="19" Foreground="{DynamicResource Brush.Ink}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding MetricTopArtistCount}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" Margin="0,3,0,0" /></StackPanel></Border>
          </Grid>
          <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Top songs" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="{Binding TopCaption}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel><ListBox Grid.Row="2" ItemsSource="{Binding TopTracks}" ItemTemplate="{StaticResource SongRow}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" MouseDoubleClick="OpenInWmpDoubleClick" /><TextBlock Grid.Row="2" Text="{Binding TopEmptyMessage}" Foreground="{DynamicResource Brush.MutedInk}" TextWrapping="Wrap" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding TopTracks.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Grid.Row="4" Content="View more &#x2192;" Command="{Binding NavigateCommand}" CommandParameter="Data:Tracks" HorizontalAlignment="Left" /></Grid></Border>
            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Top albums" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="{Binding MetricPeriodCaption}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel><ListBox Grid.Row="2" ItemsSource="{Binding TopAlbums}" ItemTemplate="{StaticResource AggregateRow}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" MouseDoubleClick="OpenInWmpDoubleClick" /><Button Grid.Row="4" Content="View more &#x2192;" Command="{Binding NavigateCommand}" CommandParameter="Data:Albums" HorizontalAlignment="Left" /></Grid></Border>
            <Border Grid.Column="4" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Top artists" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="{Binding MetricPeriodCaption}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel><ListBox Grid.Row="2" ItemsSource="{Binding TopArtists}" ItemTemplate="{StaticResource AggregateRow}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" MouseDoubleClick="OpenInWmpDoubleClick" /><Button Grid.Row="4" Content="View more &#x2192;" Command="{Binding NavigateCommand}" CommandParameter="Data:Artists" HorizontalAlignment="Left" /></Grid></Border>
          </Grid>
      </Grid>

      <Grid Grid.Column="1" Margin="28,25,28,20" Visibility="{Binding LatestSnapshotVisibility}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Snapshot history" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="{Binding LatestSnapshotCaption}" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,0" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox Style="{StaticResource PeriodComboBox}" Width="218" Height="32" ItemsSource="{Binding SnapshotOptions}" SelectedItem="{Binding SelectedSnapshot}" DisplayMemberPath="Label" Margin="0,0,8,0" /><Button Content="Refresh" Command="{Binding RefreshCommand}" /></StackPanel>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="{Binding SnapshotSummaryLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" /><TextBlock Text="{Binding LatestSnapshotSummary}" FontFamily="{StaticResource Font.Display}" FontSize="18" Foreground="{DynamicResource Brush.Ink}" Margin="0,4,0,0" /></StackPanel></Border>
        <Border Grid.Row="4" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="14,0" Background="{DynamicResource Brush.SurfaceMuted}" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="88" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions><TextBlock Text="#" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="TRACK" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="ALBUM" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="LENGTH" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding SnapshotListenColumnHeader}" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="TOTAL" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /></Grid>
            <Grid Grid.Row="1"><ListBox ItemsSource="{Binding LatestSnapshotTracks}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="{x:Type ListBoxItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="0,0,0,1" Padding="14,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="88" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Rank}" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource SnapshotChangeTrack}" /><TextBlock Grid.Column="2" Text="{Binding Album}" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" /><TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{DynamicResource Brush.MutedInk}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding ListensLabel}" Foreground="{DynamicResource Brush.Accent}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="{Binding TotalCountLabel}" Foreground="{DynamicResource Brush.MutedInk}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding LatestSnapshotEmptyMessage}" Foreground="{DynamicResource Brush.MutedInk}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding LatestSnapshotTracks.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding GraphsVisibility}">
        <StackPanel Margin="28,25,28,20"><TextBlock Text="Graphs" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="Explore activity observed between your local snapshots" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,22" />
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18"><StackPanel>
            <TextBlock Text="Listening activity" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="{Binding GraphSummary}" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,16" />
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="RANGE" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><ComboBox Style="{StaticResource PeriodComboBox}" ItemsSource="{Binding GraphRangeOptions}" SelectedItem="{Binding SelectedGraphRange}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="MEASURE" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><ComboBox Style="{StaticResource PeriodComboBox}" ItemsSource="{Binding GraphMeasureOptions}" SelectedItem="{Binding SelectedGraphMeasure}" /></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="GROUP BY" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><ComboBox Style="{StaticResource PeriodComboBox}" ItemsSource="{Binding GraphGroupingOptions}" SelectedItem="{Binding SelectedGraphGrouping}" /></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="GRANULARITY" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><ComboBox Style="{StaticResource PeriodComboBox}" ItemsSource="{Binding GraphGranularityOptions}" SelectedItem="{Binding SelectedGraphGranularity}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="CHART" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><ComboBox Style="{StaticResource PeriodComboBox}" ItemsSource="{Binding GraphModeOptions}" SelectedItem="{Binding SelectedGraphMode}" /></StackPanel>
              <StackPanel Grid.Column="4" Visibility="{Binding GraphSeriesOptionsVisibility}"><TextBlock Text="SERIES" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><StackPanel Orientation="Horizontal"><ComboBox Style="{StaticResource PeriodComboBox}" Width="112" ItemsSource="{Binding GraphTopSeriesOptions}" SelectedItem="{Binding SelectedGraphTopSeries}" /><CheckBox Style="{StaticResource BaselineToggle}" Content="Combine rest as Other" IsChecked="{Binding CombineRemainingGraphSeries, Mode=TwoWay}" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Visibility="{Binding GraphCustomDateVisibility}" Margin="0,0,0,16"><StackPanel Width="150"><TextBlock Text="CUSTOM FROM" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><DatePicker SelectedDate="{Binding GraphStartDate}" /></StackPanel><StackPanel Width="150" Margin="12,0,0,0"><TextBlock Text="CUSTOM TO" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><DatePicker SelectedDate="{Binding GraphEndDate}" /></StackPanel></StackPanel>
            <Grid Height="340" Background="{DynamicResource Brush.SurfaceMuted}" ClipToBounds="True"><lvc:CartesianChart Series="{Binding GraphSeries}" XAxes="{Binding GraphXAxes}" YAxes="{Binding GraphYAxes}" Background="{DynamicResource Brush.Surface}" LegendPosition="Hidden" TooltipPosition="Top" TooltipFindingStrategy="ExactMatch" Visibility="{Binding GraphChartVisibility}"><lvc:CartesianChart.Tooltip><local:SinglePointTooltip /></lvc:CartesianChart.Tooltip></lvc:CartesianChart><StackPanel Visibility="{Binding GraphEmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Font.Icon}" FontSize="30" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" /><TextBlock Text="{Binding GraphEmptyMessage}" Foreground="{DynamicResource Brush.MutedInk}" TextWrapping="Wrap" TextAlignment="Center" Width="300" Margin="0,10,0,0" /></StackPanel></Grid>
            <ScrollViewer MaxHeight="98" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0"><ItemsControl ItemsSource="{Binding GraphLegendItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,20,8"><Ellipse Width="11" Height="11" Fill="{Binding Color}" Stroke="{Binding Color}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" MaxWidth="170" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <TextBlock Text="{Binding GraphHelpText}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" Margin="28,25,28,20" Visibility="{Binding DataVisibility}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Listening history" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="{Binding SnapshotSummary}" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,0" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox Style="{StaticResource PeriodComboBox}" Width="148" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" Height="32" Margin="0,0,8,0" /><Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" /><Button Content="{Binding CaptureButtonText}" Command="{Binding CaptureCommand}" IsEnabled="{Binding CanCapture}" Style="{StaticResource PrimaryButton}" /></StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Margin="18,16,18,0"><TextBlock Text="{Binding DataTitle}" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="{Binding DataCaption}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
            <Grid Grid.Row="2" Margin="14,0" Background="{DynamicResource Brush.SurfaceMuted}" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions><TextBlock Text="#" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="ITEM" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding DataContextColumn}" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="LISTENS" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /></Grid>
            <Grid Grid.Row="3"><ListBox ItemsSource="{Binding DataRows}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="{x:Type ListBoxItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="0,0,0,1" Padding="14,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Rank}" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="2"><Image Source="{Binding Artwork}" Stretch="UniformToFill" /></Border><StackPanel Grid.Column="1" Margin="8,1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel></Grid><TextBlock Grid.Column="2" Text="{Binding Context}" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" /><TextBlock Grid.Column="3" Text="{Binding CountLabel}" Foreground="{DynamicResource Brush.Accent}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding TopEmptyMessage}" Foreground="{DynamicResource Brush.MutedInk}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding SettingsVisibility}">
        <StackPanel Margin="28,25,28,20" MaxWidth="720"><TextBlock Text="Settings" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="Controls for local snapshot collection and optional integrations" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,22" />
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,0,0,14"><StackPanel>
            <TextBlock Text="Appearance" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="Choose the workspace theme and its accent color. Changes apply immediately and stay on this computer." Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,14" TextWrapping="Wrap" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="THEME" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><ComboBox Style="{StaticResource PeriodComboBox}" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="ACCENT HUE" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{Binding AccentPreview}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="3" /><Slider Grid.Column="2" Minimum="0" Maximum="359" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding AccentHue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" /></Grid><TextBlock Text="{Binding AccentHueLabel}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
            </Grid>
            <Button Content="Restore default appearance" Command="{Binding ResetAppearanceCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
          </StackPanel></Border>
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="Automatic snapshots" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="{Binding SchedulerState}" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,14" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal"><Button Content="Open Task Scheduler" Command="{Binding OpenSchedulerCommand}" Margin="0,0,8,0" /><Button Content="{Binding AutomaticSnapshotsToggleText}" Command="{Binding ToggleSchedulerCommand}" /></StackPanel></StackPanel></Border>
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="Snapshot status" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="View the same local summary as the terminal status command" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,14" /><Button Content="View snapshot status" Command="{Binding ShowSnapshotStatusCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="First-seen counts" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="Treat a track's current WMP play total as activity on the snapshot where Wrap first sees it. This keeps newly added albums visible; turn it off for strict delta-only reporting." Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,14" TextWrapping="Wrap" /><CheckBox Style="{StaticResource BaselineToggle}" Content="Include first-seen track counts in listening totals" IsChecked="{Binding IncludeBaselineSnapshot, Mode=TwoWay}" /></StackPanel></Border>
          <Border x:Name="DiscordRpcSettingsCard" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,0,0,14"><StackPanel>
            <TextBlock Text="Discord Rich Presence" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="Opt in to share the current Windows Media Player track through your local Discord desktop client" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,14" TextWrapping="Wrap" />
            <CheckBox Style="{StaticResource BaselineToggle}" Content="Enable Discord Rich Presence" IsChecked="{Binding DiscordRpcEnabled, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource BaselineToggle}" Content="Keep the last track during short WMP handoffs" IsChecked="{Binding KeepDiscordPresenceBetweenTracks, Mode=TwoWay}" Margin="0,8,0,0" />
            <TextBlock Text="Keeps the most recent status for up to 5 seconds between songs. Turn this off to clear Discord immediately when WMP briefly has no track." Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" Margin="26,3,0,0" TextWrapping="Wrap" />
            <CheckBox Style="{StaticResource BaselineToggle}" Content="Keep Discord Rich Presence running when this window closes" IsChecked="{Binding KeepDiscordPresenceRunningWhenClosed, Mode=TwoWay}" Margin="0,10,0,0" />
            <TextBlock Text="Closes Wrap to the notification area while it continues monitoring WMP. Use the tray icon to reopen or exit it completely." Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" Margin="26,3,0,0" TextWrapping="Wrap" />
            <TextBlock Text="DISCORD APPLICATION ID" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,16,0,4" />
            <TextBox Text="{Binding DiscordApplicationId, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="10,5" BorderBrush="{DynamicResource Brush.Rule}" Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="Custom application IDs require their own wmp_icon, wmp_empty, and album-art assets in the Discord Developer Portal." Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" Margin="0,5,0,14" TextWrapping="Wrap" />
            <WrapPanel Margin="0,0,0,14"><Button Content="Save &amp; reconnect" Command="{Binding SaveDiscordSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" /><Button Content="Refresh now" Command="{Binding RefreshDiscordCommand}" IsEnabled="{Binding DiscordRpcEnabled}" Margin="0,0,8,8" /><Button Content="Reconnect" Command="{Binding ReconnectDiscordCommand}" IsEnabled="{Binding DiscordRpcEnabled}" Margin="0,0,8,8" /><Button Content="Open Developer Portal" Command="{Binding OpenDiscordDeveloperPortalCommand}" Margin="0,0,8,8" /><Button Content="Album art…" Command="{Binding OpenAlbumArtCommand}" IsEnabled="{Binding CanManageAlbumArt}" Margin="0,0,8,8" /></WrapPanel>
            <Border Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="3" Padding="12"><StackPanel>
              <TextBlock Text="{Binding DiscordStatus}" Foreground="{DynamicResource Brush.Ink}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DiscordNowPlaying}" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,3,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DiscordArtworkStatus}" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,3,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DiscordLastUpdated}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" Margin="0,3,0,0" />
              <TextBlock Text="{Binding DiscordLastError}" Foreground="{DynamicResource Brush.Error}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel></Border>
          </StackPanel></Border>
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="Windows Media Player" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="Open a song or the first song in an album or artist from a result row" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,14" TextWrapping="Wrap" /><CheckBox Style="{StaticResource BaselineToggle}" Content="Open songs, albums, and artists on double-click" IsChecked="{Binding OpenInWmpOnDoubleClick, Mode=TwoWay}" /></StackPanel></Border>
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="Project" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="Source code and release notes" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,14" /><Button Command="{Binding OpenGitHubCommand}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Font.Icon}" FontSize="15" Margin="0,0,7,0" /><TextBlock Text="View on GitHub" /></StackPanel></Button></StackPanel></Border>
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18"><StackPanel><TextBlock Text="Updates" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,14" /><Button Content="{Binding UpdateButtonText}" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding CanCheckForUpdates}" HorizontalAlignment="Left" /></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding AlbumArtVisibility}">
        <StackPanel Margin="28,25,28,20" MaxWidth="860">
          <TextBlock Text="Discord album art" FontFamily="{StaticResource Font.Display}" FontSize="25" Foreground="{DynamicResource Brush.Ink}" />
          <TextBlock Text="Pair an exact album artist and album title with the image asset key uploaded to your Discord application." Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,22" TextWrapping="Wrap" />
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="132" Height="132" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="4"><Image Source="{Binding AlbumArtPreview}" Stretch="UniformToFill" /></Border>
            <StackPanel Grid.Column="2"><TextBlock Text="Local preview" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" /><TextBlock Text="{Binding AlbumArtPreviewStatus}" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,14" TextWrapping="Wrap" /><TextBlock Text="The image above is resolved from your local WMP library. Discord validates the configured asset key only when the presence is sent." Foreground="{DynamicResource Brush.Warning}" FontSize="11" TextWrapping="Wrap" /></StackPanel>
          </Grid></Border>
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,0,0,14"><StackPanel>
            <TextBlock Text="Mapping" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="Exact matching prevents albums with the same title from sharing artwork." Foreground="{DynamicResource Brush.MutedInk}" Margin="0,4,0,14" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ALBUM ARTIST" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><TextBox Text="{Binding AlbumArtArtist, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="10,5" BorderBrush="{DynamicResource Brush.Rule}" Foreground="{DynamicResource Brush.Ink}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ALBUM TITLE" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,0,0,4" /><TextBox Text="{Binding AlbumArtTitle, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="10,5" BorderBrush="{DynamicResource Brush.Rule}" Foreground="{DynamicResource Brush.Ink}" /></StackPanel></Grid>
            <TextBlock Text="RICH PRESENCE ART ASSET FILE NAME" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" Margin="0,14,0,4" /><TextBox Text="{Binding AlbumArtAssetKey, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="10,5" BorderBrush="{DynamicResource Brush.Rule}" Foreground="{DynamicResource Brush.Ink}" />
            <WrapPanel Margin="0,14,0,0"><Button Content="Use current WMP track" Command="{Binding UseCurrentTrackForAlbumArtCommand}" Margin="0,0,8,8" /><Button Content="Save mapping" Command="{Binding SaveAlbumArtMappingCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" /><Button Content="Delete selected" Command="{Binding DeleteAlbumArtMappingCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" /></WrapPanel>
          </StackPanel></Border>
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="1" CornerRadius="4" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="14,0" Background="{DynamicResource Brush.SurfaceMuted}" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="ALBUM ARTIST" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="ALBUM" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="RPC ASSET FILE NAME" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.MutedInk}" VerticalAlignment="Center" /></Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding AlbumArtMappings}" SelectedItem="{Binding SelectedAlbumArtMapping}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="{x:Type ListBoxItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="0,0,0,1" Padding="14,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding AlbumArtist}" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding AlbumTitle}" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding AssetKey}" Foreground="{DynamicResource Brush.Accent}" FontFamily="{StaticResource Font.Mono}" TextTrimming="CharacterEllipsis" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceMuted}" BorderBrush="{DynamicResource Brush.Rule}" BorderThickness="0,1,0,0" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="{Binding DiscordFooterStatus}" Command="{Binding OpenDiscordSettingsCommand}" ToolTip="{Binding DiscordFooterToolTip}" Cursor="Hand" FontSize="11" Foreground="{DynamicResource Brush.MutedInk}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" MinHeight="0" VerticalAlignment="Center" HorizontalAlignment="Left" /><TextBlock Grid.Column="2" Text="{Binding DataLocationLabel}" Foreground="{DynamicResource Brush.MutedInk}" FontSize="11" VerticalAlignment="Center" /><Button Grid.Column="3" Content="{Binding AppVersion}" Command="{Binding OpenReleasesCommand}" ToolTip="View releases on GitHub" Cursor="Hand" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.MutedInk}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" MinHeight="0" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border>
  </Grid>
</Window>
